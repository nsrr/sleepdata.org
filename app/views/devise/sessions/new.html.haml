- @title = "Sign in"

- render "themes/seasonal"
- @footer = "dark"

.page-box.last-box.d-flex.align-items-center.theme-bg{ class: "theme-#{@theme}-focus-bg" }
  .container
    %p.lead.text-center.text-white Welcome back!

    .sign-up-form
      .sign-up-form-title
        Sign in

      = form_with model: resource, url: user_session_path, local: true do |form|
        .form-group
          = form.label :email
          = form.email_field :email, class: "form-control#{" is-invalid" if flash[:alert].present?}", autocomplete: "off", autocorrect: "off", autocapitalize: "none", spellcheck: "false"

        .form-group
          = form.label :password
          %small= link_to "(Forgot password?)", new_password_path(resource_name), tabindex: "-1"
          = form.password_field :password, class: "form-control#{" is-invalid" if flash[:alert].present?}", autocomplete: "current-password"
          - if flash[:alert].present?
            .invalid-feedback= flash[:alert].html_safe

        .card.p-3.secondary{{ style: "background-color: #ededed" }}
          .form-group
            .custom-control.custom-checkbox
              = form.check_box :not_covered_person_or_located_in_country_of_concern_attestation, class: "custom-control-input#{" is-invalid" if resource.errors[:not_covered_person_or_located_in_country_of_concern_attestation].present?}", id: :not_covered_person_or_located_in_country_of_concern_attestation
              = label_tag :not_covered_person_or_located_in_country_of_concern_attestation, class: "custom-control-label" do
                = render "devise/shared/attestation_text"
              = render "forms/invalid_feedback", object: resource, key: :not_covered_person_or_located_in_country_of_concern_attestation

        .form-group.submit-btn-container
          = form.submit "Sign in", class: "btn btn-primary btn-block btn-shadow"

        - flash[:alert] = nil

    .sign-up-form.text-center
      New to the NSRR?
      = link_to "Create an account.", new_user_registration_path
